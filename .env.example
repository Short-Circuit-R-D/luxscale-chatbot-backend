# === LLM (Groq) ===
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# === Embeddings (HuggingFace, local) ===
EMBEDDING_MODEL=BAAI/bge-m3
# leave empty to force CPU; e.g. "cpu" | "cuda" | "mps"
EMBEDDING_DEVICE=

# === Qdrant ===
# Primary (e.g. Railway internal). Falls back to QDRANT_URL_LOCALHOST if unreachable.
QDRANT_URL=http://qdrant.railway.internal:6333
QDRANT_URL_LOCALHOST=http://localhost:6333
QDRANT_COLLECTION=standards

# === MongoDB ===
MONGO_URI=mongodb://localhost:27017
MONGO_DB=luxscale_chatbot
MONGO_STANDARDS_COLLECTION=standards_clauses

# === Retrieval ===
TOP_K=5

# === Auth (future) ===
# API_KEY=

PORT=5000